{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedsharepointonline_finance"
        },
        "api": {
          "name": "shared_sharepointonline"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "new_sharedoffice365_finance"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "Finance mailbox (new_FinanceMailbox)": {
          "defaultValue": "finance@contoso.com",
          "type": "String",
          "metadata": {
            "schemaName": "new_FinanceMailbox"
          }
        }
      },
      "triggers": {
        "Every_weekday_morning": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Week",
            "interval": 1,
            "schedule": {
              "weekDays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
              "hours": ["8"]
            }
          }
        }
      },
      "actions": {
        "Get_pending_invoices": {
          "type": "OpenApiConnection",
          "runAfter": {},
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/finance",
              "table": "Invoices",
              "$filter": "Status eq 'Pending'"
            }
          }
        },
        "Any_pending": {
          "type": "If",
          "runAfter": {
            "Get_pending_invoices": ["Succeeded"]
          },
          "expression": {
            "greater": ["@length(outputs('Get_pending_invoices')?['body/value'])", 0]
          },
          "actions": {
            "Send_reminder": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "@parameters('Finance mailbox (new_FinanceMailbox)')",
                  "emailMessage/Subject": "@{length(outputs('Get_pending_invoices')?['body/value'])} invoices waiting for approval",
                  "emailMessage/Body": "<p>Please review the pending invoices.</p>"
                }
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
