{
  "name": "00000000-0000-0000-0000-000000000001",
  "properties": {
    "displayName": "Sample - Invoice approval",
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": { "defaultValue": {}, "type": "Object" }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "recurrence": { "frequency": "Minute", "interval": 5 },
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "connectionName": "shared_sharepointonline",
              "operationId": "GetOnNewItems"
            },
            "parameters": {
              "dataset": "https://contoso.sharepoint.com/sites/finance",
              "table": "Invoices"
            }
          }
        }
      },
      "actions": {
        "Initialize_ApprovalStatus": {
          "type": "InitializeVariable",
          "runAfter": {},
          "inputs": {
            "variables": [{ "name": "ApprovalStatus", "type": "string", "value": "Pending" }]
          }
        },
        "Try": {
          "type": "Scope",
          "runAfter": { "Initialize_ApprovalStatus": ["Succeeded"] },
          "actions": {
            "Get_approver": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365users",
                  "connectionName": "shared_office365users",
                  "operationId": "Manager_V2"
                },
                "parameters": { "id": "@triggerOutputs()?['body/Author/Email']" }
              }
            },
            "Check_amount": {
              "type": "If",
              "runAfter": { "Get_approver": ["Succeeded"] },
              "expression": {
                "and": [{ "greater": ["@triggerOutputs()?['body/Amount']", 10000] }]
              },
              "actions": {
                "Start_and_wait_for_an_approval": {
                  "type": "OpenApiConnection",
                  "runAfter": {},
                  "inputs": {
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_approvals",
                      "connectionName": "shared_approvals",
                      "operationId": "StartAndWaitForAnApproval"
                    },
                    "parameters": {
                      "approvalType": "Basic",
                      "WebhookApprovalCreationInput/title": "Approve invoice @{triggerOutputs()?['body/Title']}",
                      "WebhookApprovalCreationInput/assignedTo": "@body('Get_approver')?['mail']"
                    }
                  }
                },
                "Switch_on_outcome": {
                  "type": "Switch",
                  "runAfter": { "Start_and_wait_for_an_approval": ["Succeeded"] },
                  "expression": "@body('Start_and_wait_for_an_approval')?['outcome']",
                  "cases": {
                    "Case_Approve": {
                      "case": "Approve",
                      "actions": {
                        "Set_status_Approved": {
                          "type": "SetVariable",
                          "runAfter": {},
                          "inputs": { "name": "ApprovalStatus", "value": "Approved" }
                        }
                      }
                    },
                    "Case_Reject": {
                      "case": "Reject",
                      "actions": {
                        "Set_status_Rejected": {
                          "type": "SetVariable",
                          "runAfter": {},
                          "inputs": { "name": "ApprovalStatus", "value": "Rejected" }
                        }
                      }
                    }
                  },
                  "default": { "actions": {} }
                }
              },
              "else": {
                "actions": {
                  "Auto_approve": {
                    "type": "SetVariable",
                    "runAfter": {},
                    "inputs": { "name": "ApprovalStatus", "value": "Approved" }
                  }
                }
              }
            },
            "Update_item": {
              "type": "OpenApiConnection",
              "runAfter": { "Check_amount": ["Succeeded"] },
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "connectionName": "shared_sharepointonline",
                  "operationId": "PatchItem"
                },
                "parameters": {
                  "dataset": "https://contoso.sharepoint.com/sites/finance",
                  "table": "Invoices",
                  "id": "@triggerOutputs()?['body/ID']",
                  "item/Status": "@variables('ApprovalStatus')"
                }
              }
            }
          }
        },
        "Catch": {
          "type": "Scope",
          "runAfter": { "Try": ["Failed", "TimedOut"] },
          "actions": {
            "Notify_admins": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
                  "connectionName": "shared_office365",
                  "operationId": "SendEmailV2"
                },
                "parameters": {
                  "emailMessage/To": "flow-admins@contoso.com",
                  "emailMessage/Subject": "Invoice approval failed",
                  "emailMessage/Body": "@{result('Try')}"
                }
              }
            },
            "Terminate": {
              "type": "Terminate",
              "runAfter": { "Notify_admins": ["Succeeded"] },
              "inputs": { "runStatus": "Failed" }
            }
          }
        },
        "Notify_each_watcher": {
          "type": "Foreach",
          "runAfter": { "Try": ["Succeeded"] },
          "foreach": "@triggerOutputs()?['body/Watchers']",
          "actions": {
            "Post_message_in_Teams": {
              "type": "OpenApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                  "connectionName": "shared_teams",
                  "operationId": "PostMessageToConversation"
                },
                "parameters": { "body/messageBody": "Invoice is @{variables('ApprovalStatus')}" }
              }
            }
          }
        }
      },
      "outputs": {}
    }
  }
}
